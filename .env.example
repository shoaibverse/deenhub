# NoorHub environment configuration
# Copy to .env and fill in the values you need. Never commit real secrets.

# PostgreSQL connection used by Drizzle ORM.
DATABASE_URL=

# Optional: Supabase project, used for hosted Postgres and Supabase Auth
# (for example Google sign-in). Leave blank to use the built-in email and
# password sign-in that NoorHub runs on its own database.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Content sources. Each has a working default; override to point NoorHub at a
# different verified source.
QURAN_API_URL=https://api.alquran.cloud/v1
HADITH_API_URL=https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@1
TAFSIR_API_URL=https://api.quran.com/api/v4
PRAYER_API_URL=
METALS_API_URL=https://api.gold-api.com

# Local prayer time calculation happens in the browser with adhan-js, so
# PRAYER_API_URL is optional and only used if you prefer a hosted service.
