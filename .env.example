# NoorHub optional environment configuration
#
# A database is NOT required. NoorHub stores personal preferences, bookmarks,
# Quran progress, favorite duas, location and Tasbeeh history in the browser.
# All content services below already have working public defaults.

# Optional canonical URL for metadata, sitemap and Open Graph links.
NEXT_PUBLIC_SITE_URL=

# Optional public email address. When set, the Contact form opens the visitor's
# mail application. Without it, the form only copies the message locally.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional content-source overrides. Leave blank or omit to use the verified
# public defaults built into NoorHub.
QURAN_API_URL=https://api.alquran.cloud/v1
HADITH_API_URL=https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@1
TAFSIR_API_URL=https://api.quran.com/api/v4
METALS_API_URL=https://api.gold-api.com

# Prayer times and qibla are calculated locally with adhan-js, so no prayer API
# or location service key is required.
